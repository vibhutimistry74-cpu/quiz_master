@model List<QuizMaster.Models.QuizAttempt>
@{
    ViewData["Title"] = "My Examination History";
    var studentName = ViewBag.UserName as string ?? "Student";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="display-6 fw-bold mb-1">My Examination History</h2>
            <p class="text-muted mb-0">Record of all completed quizzes, grades, and answer reviews for @studentName.</p>
        </div>
        <a asp-controller="Quiz" asp-action="Index" class="btn-qm-primary">
            <i class="bi bi-plus-circle"></i> Take New Quiz
        </a>
    </div>

    <div class="qm-card p-4">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-clock-history text-muted" style="font-size: 3.5rem;"></i>
                <h4 class="fw-bold mt-3 mb-1">No Quiz Attempts Found</h4>
                <p class="text-muted small mb-4">You have not completed any examinations yet. Browse available tests to get started!</p>
                <a asp-controller="Quiz" asp-action="Index" class="btn btn-qm-primary">
                    Browse Available Quizzes
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Quiz</th>
                            <th>Category</th>
                            <th>Date & Time</th>
                            <th>Score</th>
                            <th>Percentage</th>
                            <th>Correct</th>
                            <th>Wrong</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var attempt in Model)
                        {
                            <tr>
                                <td>
                                    <strong class="text-dark">@attempt.QuizTitle</strong>
                                </td>
                                <td>
                                    <span class="badge-category">@attempt.Category</span>
                                </td>
                                <td class="text-muted small">
                                    @attempt.CompletedAt.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")
                                </td>
                                <td>
                                    <strong>@attempt.Score</strong> / @attempt.TotalMarks
                                </td>
                                <td>
                                    <span class="fw-bold @(attempt.Status == "Passed" ? "text-success" : "text-danger")">
                                        @attempt.Percentage%
                                    </span>
                                </td>
                                <td>
                                    <span class="text-success fw-semibold"><i class="bi bi-check-circle"></i> @attempt.CorrectAnswers</span>
                                </td>
                                <td>
                                    <span class="text-danger fw-semibold"><i class="bi bi-x-circle"></i> @attempt.WrongAnswers</span>
                                </td>
                                <td>
                                    <span class="badge-status-@attempt.Status.ToLowerInvariant()">
                                        <i class="bi @(attempt.Status == "Passed" ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                        @attempt.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-controller="Quiz" asp-action="Result" asp-route-attemptId="@attempt.Id" class="btn btn-sm btn-qm-secondary" title="View Scorecard">
                                            <i class="bi bi-trophy"></i> Result
                                        </a>
                                        <a asp-controller="Quiz" asp-action="Review" asp-route-attemptId="@attempt.Id" class="btn btn-sm btn-qm-outline-primary" title="Review Question Explanations">
                                            <i class="bi bi-list-check"></i> Review
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
