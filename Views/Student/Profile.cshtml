@model QuizMaster.Models.ProfileViewModel
@{
    ViewData["Title"] = "Student Profile";
}

<div class="container py-4">
    <div class="row g-4">
        <!-- Profile Summary Card -->
        <div class="col-lg-4">
            <div class="qm-card p-4 text-center">
                <div class="position-relative d-inline-block mb-3">
                    <img src="@Model.ProfileImage" alt="@Model.FullName" width="100" height="100" class="rounded-circle border border-3 border-primary shadow-sm" />
                    <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-success p-2">
                        <i class="bi bi-check-lg text-white"></i>
                    </span>
                </div>
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-3">@Model.Email</p>

                <div class="d-inline-block mb-4">
                    <span class="role-pill role-student px-3 py-1 fs-6">@Model.Role Account</span>
                </div>

                <div class="p-3 bg-light rounded-3 text-start small border">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Account ID:</span>
                        <span class="fw-semibold">#@Model.Id</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Joined Date:</span>
                        <span class="fw-semibold">@Model.JoinedDate.ToString("MMMM dd, yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Status:</span>
                        <span class="text-success fw-bold"><i class="bi bi-circle-fill" style="font-size: 8px;"></i> Active</span>
                    </div>
                </div>
            </div>

            <!-- Performance Metrics Quick Card -->
            <div class="qm-card p-4 mt-4">
                <h6 class="fw-bold text-uppercase text-muted small mb-3">Performance Overview</h6>
                <div class="row g-3 text-center">
                    <div class="col-6">
                        <div class="p-2 border rounded-2 bg-light">
                            <h4 class="fw-bold mb-0 text-primary">@Model.QuizzesTaken</h4>
                            <span class="small text-muted">Attempts</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 border rounded-2 bg-light">
                            <h4 class="fw-bold mb-0 text-success">@Model.PassedQuizzes</h4>
                            <span class="small text-muted">Passed</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 border rounded-2 bg-light">
                            <h4 class="fw-bold mb-0 text-info">@Model.AverageScore%</h4>
                            <span class="small text-muted">Avg Score</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 border rounded-2 bg-light">
                            <h4 class="fw-bold mb-0 text-warning-emphasis">@Model.BestScore%</h4>
                            <span class="small text-muted">Best Score</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Profile Form -->
        <div class="col-lg-8">
            <div class="qm-card p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1">Edit Account Details</h4>
                        <p class="text-muted small mb-0">Update your student name, email, or change your password.</p>
                    </div>
                    <span class="badge bg-light text-muted border">In-Memory Storage</span>
                </div>

                <form asp-controller="Student" asp-action="EditProfile" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label">Full Name</label>
                            <input name="FullName" value="@Model.FullName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email Address</label>
                            <input name="Email" type="email" value="@Model.Email" class="form-control" required />
                        </div>
                    </div>

                    <h5 class="fw-bold mt-4 mb-3 border-top pt-3">Change Password <span class="text-muted small fw-normal">(Optional)</span></h5>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label class="form-label">Current Password</label>
                            <input name="CurrentPassword" type="password" class="form-control" placeholder="Required only if changing password" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">New Password</label>
                            <input name="NewPassword" type="password" class="form-control" placeholder="Minimum 6 characters" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Confirm New Password</label>
                            <input name="ConfirmNewPassword" type="password" class="form-control" placeholder="Re-type new password" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Student" asp-action="Dashboard" class="btn btn-qm-secondary">Cancel</a>
                        <button type="submit" class="btn btn-qm-primary">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
