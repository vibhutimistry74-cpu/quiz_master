@model List<QuizMaster.Models.Quiz>
@{
    ViewData["Title"] = "Online Quiz & Examination System";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="hero-pill">
                    <i class="bi bi-stars text-warning"></i>
                    <span>Next-Generation Online Examination Platform</span>
                </div>
                <h1 class="hero-title">
                    Test Your Knowledge. <br>
                    <span class="hero-gradient-text">Challenge Yourself.</span>
                </h1>
                <p class="hero-subtitle">
                    Learn, compete and improve your skills with interactive quizzes. Real-time timed examinations with immediate scoring, detailed explanations, and competitive leaderboards.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Quiz" asp-action="Index" class="btn-qm-primary btn-lg">
                        <i class="bi bi-compass"></i> Explore Quizzes
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn-qm-secondary btn-lg">
                        <i class="bi bi-person-plus"></i> Get Started Free
                    </a>
                </div>

                <div class="mt-4 pt-3 d-flex align-items-center gap-4 text-muted small">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span>Instant Automated Grading</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-trophy text-warning fs-5"></i>
                        <span>Global Leaderboards</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-visual-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <img src="~/images/quizzes/aspnet.svg" alt="ASP.NET Core" width="54" height="54" style="border-radius: 12px;" />
                            <div>
                                <span class="badge-category mb-1">Web Development</span>
                                <h5 class="mb-0">ASP.NET Core MVC Examination</h5>
                            </div>
                        </div>
                        <div class="timer-pill">
                            <i class="bi bi-stopwatch-fill"></i>
                            <span>08:42</span>
                        </div>
                    </div>

                    <div class="p-3 bg-white border rounded-3 mb-3 shadow-sm">
                        <div class="text-muted small mb-1 fw-bold">QUESTION 3 OF 10</div>
                        <p class="mb-3 fw-semibold text-dark">Which architectural pattern is implemented by ASP.NET Core MVC?</p>

                        <div class="d-flex flex-column gap-2">
                            <div class="p-2 border rounded-2 d-flex align-items-center gap-2 small text-muted">
                                <span class="badge bg-light text-dark">A</span> MVVM Pattern
                            </div>
                            <div class="p-2 border border-primary bg-primary bg-opacity-10 rounded-2 d-flex align-items-center gap-2 small text-primary fw-bold">
                                <span class="badge bg-primary">B</span> Model-View-Controller (MVC)
                                <i class="bi bi-check-circle-fill ms-auto"></i>
                            </div>
                            <div class="p-2 border rounded-2 d-flex align-items-center gap-2 small text-muted">
                                <span class="badge bg-light text-dark">C</span> MVP Pattern
                            </div>
                        </div>
                    </div>

                    <!-- Progress bar -->
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Progress</span>
                        <span class="fw-bold text-primary">80%</span>
                    </div>
                    <div class="quiz-progress-track">
                        <div class="quiz-progress-fill" style="width: 80%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Statistics Banner -->
<section class="stats-banner">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <div class="stat-number">50+</div>
                    <div class="stat-label">Available Quizzes</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <div class="stat-number">500+</div>
                    <div class="stat-label">Curated Questions</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <div class="stat-number">1,000+</div>
                    <div class="stat-label">Active Students</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <div class="stat-number">10,000+</div>
                    <div class="stat-label">Examinations Taken</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Popular Categories -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge-category mb-2">Subject Diversity</span>
            <h2 class="display-6 fw-bold">Explore Popular Categories</h2>
            <p class="text-muted">Choose your subject area to test your knowledge against standard academic questions.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-2 col-md-4 col-6">
                <a asp-controller="Quiz" asp-action="Index" asp-route-category="Programming" class="category-card">
                    <div class="category-icon-box">
                        <i class="bi bi-code-slash"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Programming</h6>
                    <span class="small text-muted">C#, Java, Python</span>
                </a>
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <a asp-controller="Quiz" asp-action="Index" asp-route-category="Web Development" class="category-card">
                    <div class="category-icon-box">
                        <i class="bi bi-globe"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Web Dev</h6>
                    <span class="small text-muted">ASP.NET, HTML, JS</span>
                </a>
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <a asp-controller="Quiz" asp-action="Index" asp-route-category="Database" class="category-card">
                    <div class="category-icon-box">
                        <i class="bi bi-database-fill"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Database</h6>
                    <span class="small text-muted">SQL, Relational, ACID</span>
                </a>
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <a asp-controller="Quiz" asp-action="Index" asp-route-category="Technology" class="category-card">
                    <div class="category-icon-box">
                        <i class="bi bi-cpu-fill"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Technology</h6>
                    <span class="small text-muted">Cloud, DevOps, AI</span>
                </a>
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <a asp-controller="Quiz" asp-action="Index" asp-route-category="Science" class="category-card">
                    <div class="category-icon-box">
                        <i class="bi bi-bezier2"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Science</h6>
                    <span class="small text-muted">Physics, Computer Sci</span>
                </a>
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <a asp-controller="Quiz" asp-action="Index" asp-route-category="General Knowledge" class="category-card">
                    <div class="category-icon-box">
                        <i class="bi bi-lightbulb-fill"></i>
                    </div>
                    <h6 class="fw-bold mb-1">General</h6>
                    <span class="small text-muted">Logic, Aptitude</span>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Featured Quizzes -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
            <div>
                <span class="badge-category mb-2">Examination Catalog</span>
                <h2 class="display-6 fw-bold mb-1">Featured Examinations</h2>
                <p class="text-muted mb-0">Select an assessment to start your timed test right away.</p>
            </div>
            <a asp-controller="Quiz" asp-action="Index" class="btn-qm-outline-primary">
                View All Quizzes <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var quiz in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="qm-card h-100 d-flex flex-column">
                        <div class="p-4 flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@quiz.ImageUrl" alt="@quiz.Title" width="48" height="48" style="border-radius: 10px;" />
                                    <div>
                                        <span class="badge-category">@quiz.Category</span>
                                    </div>
                                </div>
                                <span class="badge-difficulty-@quiz.Difficulty.ToLowerInvariant()">
                                    @quiz.Difficulty
                                </span>
                            </div>

                            <h5 class="fw-bold mb-2">@quiz.Title</h5>
                            <p class="text-muted small mb-4" style="min-height: 40px;">@quiz.Description</p>

                            <div class="row g-2 pt-3 border-top small text-muted">
                                <div class="col-6 d-flex align-items-center gap-2">
                                    <i class="bi bi-question-circle text-primary"></i>
                                    <span><strong>@quiz.TotalQuestions</strong> Questions</span>
                                </div>
                                <div class="col-6 d-flex align-items-center gap-2">
                                    <i class="bi bi-clock text-primary"></i>
                                    <span><strong>@quiz.DurationMinutes</strong> Minutes</span>
                                </div>
                                <div class="col-6 d-flex align-items-center gap-2">
                                    <i class="bi bi-check2-circle text-success"></i>
                                    <span>Pass: <strong>@quiz.PassingPercentage%</strong></span>
                                </div>
                                <div class="col-6 d-flex align-items-center gap-2">
                                    <i class="bi bi-award text-warning"></i>
                                    <span>Certified</span>
                                </div>
                            </div>
                        </div>

                        <div class="p-4 pt-0">
                            <a asp-controller="Quiz" asp-action="Details" asp-route-id="@quiz.Id" class="btn btn-qm-primary w-100 justify-content-center">
                                Start Examination <i class="bi bi-play-circle-fill"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- How It Works -->
<section class="py-5">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="badge-category mb-2">Simple 3-Step Process</span>
            <h2 class="display-6 fw-bold">How QuizMaster Works</h2>
            <p class="text-muted">Intuitive examination flow designed for rigorous academic assessments.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h5 class="fw-bold mb-2">Choose a Quiz</h5>
                    <p class="text-muted small mb-0">
                        Browse our catalog of software development, database, and computer science quizzes. Filter by difficulty, category, or duration.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">2</div>
                    <h5 class="fw-bold mb-2">Test Your Knowledge</h5>
                    <p class="text-muted small mb-0">
                        Answer multiple-choice questions with a real-time countdown timer. Navigate freely between questions and monitor answered states.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">3</div>
                    <h5 class="fw-bold mb-2">Get Your Result</h5>
                    <p class="text-muted small mb-0">
                        Automatic grading instantly calculates your score percentage and pass/fail outcome. Review detailed explanations for every question.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="py-5 bg-white border-top">
    <div class="container">
        <div class="p-5 rounded-4 text-center text-white" style="background: linear-gradient(135deg, #1e1b4b 0%, #4f46e5 100%); box-shadow: 0 20px 40px -15px rgba(79, 70, 229, 0.4);">
            <h2 class="display-6 fw-bold text-white mb-3">Ready to Assess Your Programming Skills?</h2>
            <p class="lead text-light mb-4" style="max-width: 650px; margin: 0 auto;">
                Sign in with our demo student credentials or create a new student account to experience the full examination flow.
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg text-primary fw-bold px-4">
                    <i class="bi bi-box-arrow-in-right"></i> Try Demo Login
                </a>
                <a asp-controller="Leaderboard" asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                    <i class="bi bi-trophy"></i> View Leaderboard
                </a>
            </div>
        </div>
    </div>
</section>
