@using QuizMaster.Services
@inject IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    bool isLoggedIn = session != null && AuthHelper.IsLoggedIn(session);
    string userRole = session != null ? AuthHelper.GetUserRole(session) : "";
    string userName = session != null ? AuthHelper.GetUserName(session) : "";
    bool isAdmin = userRole == "Admin";
    bool isStudent = userRole == "Student";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuizMaster | Online Quiz & Examination System</title>
    <meta name="description" content="QuizMaster - Professional online quiz and examination platform for students and educators." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom Platform Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/quiz.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Top Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-qm">
            <div class="container">
                <a class="navbar-brand-qm" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <div>
                        <span class="brand-text">QuizMaster</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#quizNavbar" aria-controls="quizNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>

                <div class="collapse navbar-collapse" id="quizNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Quiz" asp-action="Index">Quizzes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Leaderboard" asp-action="Index">Leaderboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @if (isLoggedIn)
                        {
                            @if (isAdmin)
                            {
                                <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-sm btn-qm-outline-primary">
                                    <i class="bi bi-speedometer2"></i> Admin Panel
                                </a>
                                <div class="user-badge">
                                    <i class="bi bi-shield-check text-warning"></i>
                                    <span>@userName</span>
                                    <span class="role-pill role-admin">Admin</span>
                                </div>
                            }
                            else
                            {
                                <a asp-controller="Student" asp-action="Dashboard" class="btn btn-sm btn-qm-outline-primary">
                                    <i class="bi bi-grid-fill"></i> Dashboard
                                </a>
                                <a asp-controller="Student" asp-action="History" class="nav-link text-sub px-2">
                                    <i class="bi bi-clock-history"></i> My Attempts
                                </a>
                                <a asp-controller="Student" asp-action="Profile" class="user-badge text-decoration-none">
                                    <i class="bi bi-person-circle"></i>
                                    <span>@userName</span>
                                    <span class="role-pill role-student">Student</span>
                                </a>
                            }

                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Logout">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn-qm-secondary">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn-qm-primary">
                                <i class="bi bi-person-plus-fill"></i> Get Started
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Toast Notifications -->
    <div class="toast-container-custom">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast-alert success" role="alert">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div class="flex-grow-1">
                    <strong class="d-block text-dark">Success</strong>
                    <span class="text-secondary small">@TempData["SuccessMessage"]</span>
                </div>
                <button type="button" class="btn-close btn-sm" onclick="this.parentElement.remove()"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast-alert error" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div class="flex-grow-1">
                    <strong class="d-block text-dark">Error</strong>
                    <span class="text-secondary small">@TempData["ErrorMessage"]</span>
                </div>
                <button type="button" class="btn-close btn-sm" onclick="this.parentElement.remove()"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="toast-alert warning" role="alert">
                <i class="bi bi-exclamation-circle-fill text-warning fs-5"></i>
                <div class="flex-grow-1">
                    <strong class="d-block text-dark">Attention</strong>
                    <span class="text-secondary small">@TempData["WarningMessage"]</span>
                </div>
                <button type="button" class="btn-close btn-sm" onclick="this.parentElement.remove()"></button>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Professional Footer -->
    <footer class="footer-qm">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-icon" style="width: 32px; height: 32px; font-size: 1rem; border-radius: 6px; background: #4f46e5; display: flex; align-items: center; justify-content: center; color: white;">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <h5 class="text-white mb-0">QuizMaster</h5>
                    </div>
                    <p class="text-muted small mb-3">
                        Online Quiz & Examination System. Designed as a modern, interactive testing platform for colleges and academies to assess student proficiency with automated grading.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-secondary">ASP.NET Core MVC</span>
                        <span class="badge bg-secondary">.NET 10</span>
                        <span class="badge bg-secondary">Zero Database In-Memory</span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white mb-3">Platform</h6>
                    <ul class="list-unstyled small d-flex flex-direction-column flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Quiz" asp-action="Index">All Quizzes</a></li>
                        <li><a asp-controller="Leaderboard" asp-action="Index">Leaderboard</a></li>
                        <li><a asp-controller="Home" asp-action="About">About System</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="text-white mb-3">Demo Accounts</h6>
                    <ul class="list-unstyled small text-muted d-flex flex-column gap-2">
                        <li>
                            <strong class="text-light">Admin:</strong> admin@quizmaster.com
                            <br><span class="text-secondary">Password: admin123</span>
                        </li>
                        <li>
                            <strong class="text-light">Student:</strong> student@quizmaster.com
                            <br><span class="text-secondary">Password: student123</span>
                        </li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white mb-3">College Demonstration</h6>
                    <p class="small text-muted mb-2">
                        Final year college evaluation project. Built strictly with in-memory state architecture without external DB dependencies.
                    </p>
                    <div class="small text-secondary">
                        <i class="bi bi-patch-check-fill text-success"></i> Presentation-Ready Build
                    </div>
                </div>
            </div>

            <div class="footer-bottom d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <div>
                    &copy; @DateTime.UtcNow.Year QuizMaster. All rights reserved.
                </div>
                <div class="d-flex gap-3 small">
                    <a asp-controller="Home" asp-action="About">Architecture</a>
                    <a asp-controller="Quiz" asp-action="Index">Browse Quizzes</a>
                    <a asp-controller="Account" asp-action="Login">Portal Login</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
