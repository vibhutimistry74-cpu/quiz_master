@model ErrorViewModel
@{
    ViewData["Title"] = "Notice";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="qm-card p-5">
                <div class="mb-3">
                    <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 3.5rem;"></i>
                </div>
                <h3 class="fw-bold mb-2">Something went wrong</h3>
                <p class="text-muted mb-4">
                    The requested page or resource could not be processed as expected. Please return to the homepage or try your operation again.
                </p>

                @if (Model?.ShowRequestId == true)
                {
                    <div class="p-2 bg-light rounded text-muted small mb-4">
                        Request Tracking ID: <code>@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-qm-primary">
                        <i class="bi bi-house"></i> Return Home
                    </a>
                    <a asp-controller="Quiz" asp-action="Index" class="btn btn-qm-secondary">
                        <i class="bi bi-compass"></i> Browse Quizzes
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
