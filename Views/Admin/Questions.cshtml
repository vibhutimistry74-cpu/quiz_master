@model List<QuizMaster.Models.Question>
@{
    var quiz = ViewBag.Quiz as QuizMaster.Models.Quiz;
    ViewData["Title"] = "Manage Questions - " + (quiz?.Title ?? "Quiz");
}

<div class="admin-layout-wrapper">
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock-fill text-warning fs-4"></i>
                <div>
                    <h6 class="text-white fw-bold mb-0">Admin Portal</h6>
                    <span class="text-muted small">System Operations</span>
                </div>
            </div>
        </div>

        <nav class="admin-sidebar-nav">
            <a asp-controller="Admin" asp-action="Dashboard" class="admin-nav-item">
                <i class="bi bi-speedometer2 admin-nav-icon"></i> Dashboard
            </a>
            <a asp-controller="Admin" asp-action="Quizzes" class="admin-nav-item active">
                <i class="bi bi-journal-text admin-nav-icon"></i> Manage Quizzes
            </a>
            <a asp-controller="Admin" asp-action="Users" class="admin-nav-item">
                <i class="bi bi-people admin-nav-icon"></i> Manage Students
            </a>
            <a asp-controller="Admin" asp-action="Results" class="admin-nav-item">
                <i class="bi bi-bar-chart-line admin-nav-icon"></i> Examination Results
            </a>
            <a asp-controller="Leaderboard" asp-action="Index" class="admin-nav-item">
                <i class="bi bi-trophy admin-nav-icon"></i> View Leaderboard
            </a>
            <div class="border-top border-secondary border-opacity-25 my-2"></div>
            <a asp-controller="Home" asp-action="Index" class="admin-nav-item">
                <i class="bi bi-house admin-nav-icon"></i> View Public Site
            </a>
        </nav>
    </aside>

    <main class="admin-content-area">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <span class="badge-category mb-1">Questions Manager</span>
                <h2 class="display-6 fw-bold mb-1">@quiz?.Title</h2>
                <p class="text-muted mb-0">Managing all @Model.Count questions for this examination.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Admin" asp-action="Quizzes" class="btn btn-qm-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Quizzes
                </a>
                <a asp-controller="Admin" asp-action="CreateQuestion" asp-route-quizId="@quiz?.Id" class="btn btn-qm-primary">
                    <i class="bi bi-plus-circle"></i> + Add Question
                </a>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="qm-card p-5 text-center">
                <i class="bi bi-question-diamond text-muted" style="font-size: 3.5rem;"></i>
                <h4 class="fw-bold mt-3 mb-1">No questions available</h4>
                <p class="text-muted small mb-4">This quiz doesn't have any questions configured yet. Add your first question now.</p>
                <a asp-controller="Admin" asp-action="CreateQuestion" asp-route-quizId="@quiz?.Id" class="btn btn-qm-primary">
                    <i class="bi bi-plus-circle"></i> Add Question
                </a>
            </div>
        }
        else
        {
            <div class="qm-card p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 admin-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Question Text & Options</th>
                                <th>Correct</th>
                                <th>Marks</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var q = Model[i];
                                <tr>
                                    <td><strong>@(i + 1)</strong></td>
                                    <td>
                                        <div class="mb-2">
                                            <strong class="text-dark fs-6">@q.QuestionText</strong>
                                        </div>
                                        <div class="row g-2 small text-muted">
                                            <div class="col-sm-6 @(q.CorrectAnswer == "A" ? "text-success fw-bold" : "")">
                                                A: @q.OptionA @(q.CorrectAnswer == "A" ? "✓" : "")
                                            </div>
                                            <div class="col-sm-6 @(q.CorrectAnswer == "B" ? "text-success fw-bold" : "")">
                                                B: @q.OptionB @(q.CorrectAnswer == "B" ? "✓" : "")
                                            </div>
                                            <div class="col-sm-6 @(q.CorrectAnswer == "C" ? "text-success fw-bold" : "")">
                                                C: @q.OptionC @(q.CorrectAnswer == "C" ? "✓" : "")
                                            </div>
                                            <div class="col-sm-6 @(q.CorrectAnswer == "D" ? "text-success fw-bold" : "")">
                                                D: @q.OptionD @(q.CorrectAnswer == "D" ? "✓" : "")
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-2 rounded-pill">
                                            Option @q.CorrectAnswer
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@q.Marks pt@(q.Marks > 1 ? "s" : "")</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-controller="Admin" asp-action="EditQuestion" asp-route-id="@q.Id" class="btn-action-icon" title="Edit Question">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <button type="button" class="btn-action-icon delete" title="Delete Question"
                                                    data-bs-toggle="modal" data-bs-target="#deleteQuestionModal"
                                                    data-question-id="@q.Id" data-quiz-id="@quiz?.Id" data-question-text="@q.QuestionText">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </main>
</div>

<!-- Delete Question Confirmation Modal -->
<div class="modal fade" id="deleteQuestionModal" tabindex="-1" aria-labelledby="deleteQuestionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger" id="deleteQuestionModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i> Delete Question
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-2">Are you sure you want to delete this question?</p>
                <div class="p-3 bg-light rounded-3 border">
                    <strong class="text-dark small" id="deleteQuestionModalText">Question Text</strong>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <form id="deleteQuestionForm" asp-controller="Admin" asp-action="DeleteQuestion" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteQuestionIdInput" value="" />
                    <input type="hidden" name="quizId" id="deleteQuestionQuizIdInput" value="" />
                    <button type="button" class="btn btn-qm-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-semibold">
                        <i class="bi bi-trash"></i> Delete Question
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
