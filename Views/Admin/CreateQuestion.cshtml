@model QuizMaster.Models.QuestionFormViewModel
@{
    ViewData["Title"] = "Add Question - " + Model.QuizTitle;
}

<div class="admin-layout-wrapper">
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock-fill text-warning fs-4"></i>
                <div>
                    <h6 class="text-white fw-bold mb-0">Admin Portal</h6>
                    <span class="text-muted small">System Operations</span>
                </div>
            </div>
        </div>

        <nav class="admin-sidebar-nav">
            <a asp-controller="Admin" asp-action="Dashboard" class="admin-nav-item">
                <i class="bi bi-speedometer2 admin-nav-icon"></i> Dashboard
            </a>
            <a asp-controller="Admin" asp-action="Quizzes" class="admin-nav-item active">
                <i class="bi bi-journal-text admin-nav-icon"></i> Manage Quizzes
            </a>
            <a asp-controller="Admin" asp-action="Users" class="admin-nav-item">
                <i class="bi bi-people admin-nav-icon"></i> Manage Students
            </a>
            <a asp-controller="Admin" asp-action="Results" class="admin-nav-item">
                <i class="bi bi-bar-chart-line admin-nav-icon"></i> Examination Results
            </a>
            <a asp-controller="Leaderboard" asp-action="Index" class="admin-nav-item">
                <i class="bi bi-trophy admin-nav-icon"></i> View Leaderboard
            </a>
            <div class="border-top border-secondary border-opacity-25 my-2"></div>
            <a asp-controller="Home" asp-action="Index" class="admin-nav-item">
                <i class="bi bi-house admin-nav-icon"></i> View Public Site
            </a>
        </nav>
    </aside>

    <main class="admin-content-area">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="display-6 fw-bold mb-1">Add Question</h2>
                <p class="text-muted mb-0">Appending question to <strong>@Model.QuizTitle</strong>.</p>
            </div>
            <a asp-controller="Admin" asp-action="Questions" asp-route-quizId="@Model.QuizId" class="btn btn-qm-secondary">
                <i class="bi bi-arrow-left"></i> Back to Questions
            </a>
        </div>

        <div class="qm-card p-4 p-md-5" style="max-width: 820px;">
            <form asp-controller="Admin" asp-action="CreateQuestion" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="QuizId" />
                <input type="hidden" asp-for="QuizTitle" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <!-- Question Text -->
                <div class="mb-3">
                    <label asp-for="QuestionText" class="form-label">Question Text</label>
                    <textarea asp-for="QuestionText" rows="3" class="form-control" placeholder="Enter clear, academically precise question prompt..." autofocus></textarea>
                    <span asp-validation-for="QuestionText" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <!-- Option A -->
                    <div class="col-md-6">
                        <label asp-for="OptionA" class="form-label">Option A</label>
                        <input asp-for="OptionA" class="form-control" placeholder="Choice A" />
                        <span asp-validation-for="OptionA" class="text-danger small"></span>
                    </div>

                    <!-- Option B -->
                    <div class="col-md-6">
                        <label asp-for="OptionB" class="form-label">Option B</label>
                        <input asp-for="OptionB" class="form-control" placeholder="Choice B" />
                        <span asp-validation-for="OptionB" class="text-danger small"></span>
                    </div>

                    <!-- Option C -->
                    <div class="col-md-6">
                        <label asp-for="OptionC" class="form-label">Option C</label>
                        <input asp-for="OptionC" class="form-control" placeholder="Choice C" />
                        <span asp-validation-for="OptionC" class="text-danger small"></span>
                    </div>

                    <!-- Option D -->
                    <div class="col-md-6">
                        <label asp-for="OptionD" class="form-label">Option D</label>
                        <input asp-for="OptionD" class="form-control" placeholder="Choice D" />
                        <span asp-validation-for="OptionD" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <!-- Correct Answer -->
                    <div class="col-md-6">
                        <label asp-for="CorrectAnswer" class="form-label">Correct Option</label>
                        <select asp-for="CorrectAnswer" class="form-select">
                            <option value="A">Option A</option>
                            <option value="B">Option B</option>
                            <option value="C">Option C</option>
                            <option value="D">Option D</option>
                        </select>
                        <span asp-validation-for="CorrectAnswer" class="text-danger small"></span>
                    </div>

                    <!-- Marks -->
                    <div class="col-md-6">
                        <label asp-for="Marks" class="form-label">Marks</label>
                        <input asp-for="Marks" type="number" min="1" max="10" class="form-control" />
                        <span asp-validation-for="Marks" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Explanation -->
                <div class="mb-4">
                    <label asp-for="Explanation" class="form-label">Explanation</label>
                    <textarea asp-for="Explanation" rows="2" class="form-control" placeholder="Explain why the designated option is correct for the student review screen..."></textarea>
                    <span asp-validation-for="Explanation" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-controller="Admin" asp-action="Questions" asp-route-quizId="@Model.QuizId" class="btn btn-qm-secondary">Cancel</a>
                    <button type="submit" class="btn btn-qm-primary">
                        <i class="bi bi-plus-lg"></i> Add Question
                    </button>
                </div>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
