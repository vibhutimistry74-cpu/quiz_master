@model List<QuizMaster.Models.Quiz>
@{
    ViewData["Title"] = "Manage Quizzes";
}

<div class="admin-layout-wrapper">
    <!-- Admin Sidebar -->
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock-fill text-warning fs-4"></i>
                <div>
                    <h6 class="text-white fw-bold mb-0">Admin Portal</h6>
                    <span class="text-muted small">System Operations</span>
                </div>
            </div>
        </div>

        <nav class="admin-sidebar-nav">
            <a asp-controller="Admin" asp-action="Dashboard" class="admin-nav-item">
                <i class="bi bi-speedometer2 admin-nav-icon"></i> Dashboard
            </a>
            <a asp-controller="Admin" asp-action="Quizzes" class="admin-nav-item active">
                <i class="bi bi-journal-text admin-nav-icon"></i> Manage Quizzes
            </a>
            <a asp-controller="Admin" asp-action="Users" class="admin-nav-item">
                <i class="bi bi-people admin-nav-icon"></i> Manage Students
            </a>
            <a asp-controller="Admin" asp-action="Results" class="admin-nav-item">
                <i class="bi bi-bar-chart-line admin-nav-icon"></i> Examination Results
            </a>
            <a asp-controller="Leaderboard" asp-action="Index" class="admin-nav-item">
                <i class="bi bi-trophy admin-nav-icon"></i> View Leaderboard
            </a>
            <div class="border-top border-secondary border-opacity-25 my-2"></div>
            <a asp-controller="Home" asp-action="Index" class="admin-nav-item">
                <i class="bi bi-house admin-nav-icon"></i> View Public Site
            </a>
        </nav>
    </aside>

    <!-- Admin Content Area -->
    <main class="admin-content-area">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h2 class="display-6 fw-bold mb-1">Quiz Management</h2>
                <p class="text-muted mb-0">Create, configure, update, or remove examination modules.</p>
            </div>
            <a asp-controller="Admin" asp-action="CreateQuiz" class="btn btn-qm-primary">
                <i class="bi bi-plus-circle"></i> + Create Quiz
            </a>
        </div>

        <div class="qm-card p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Quiz Name</th>
                            <th>Category</th>
                            <th>Difficulty</th>
                            <th>Questions</th>
                            <th>Duration</th>
                            <th>Passing %</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var quiz in Model)
                        {
                            <tr>
                                <td><strong>#@quiz.Id</strong></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@quiz.ImageUrl" alt="@quiz.Title" width="34" height="34" style="border-radius: 6px;" />
                                        <div>
                                            <strong class="text-dark d-block">@quiz.Title</strong>
                                            <span class="text-muted small">Created: @quiz.CreatedDate.ToString("MMM dd, yyyy")</span>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge-category">@quiz.Category</span></td>
                                <td><span class="badge-difficulty-@quiz.Difficulty.ToLowerInvariant()">@quiz.Difficulty</span></td>
                                <td>
                                    <a asp-controller="Admin" asp-action="Questions" asp-route-quizId="@quiz.Id" class="text-primary fw-bold text-decoration-none" title="Manage Questions">
                                        @quiz.TotalQuestions Qs <i class="bi bi-arrow-up-right-square"></i>
                                    </a>
                                </td>
                                <td>@quiz.DurationMinutes mins</td>
                                <td>@quiz.PassingPercentage%</td>
                                <td>
                                    <span class="badge @(quiz.IsActive ? "bg-success" : "bg-secondary")">
                                        @(quiz.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-controller="Admin" asp-action="Questions" asp-route-quizId="@quiz.Id" class="btn-action-icon" title="Manage Questions">
                                            <i class="bi bi-question-circle"></i>
                                        </a>
                                        <a asp-controller="Admin" asp-action="EditQuiz" asp-route-id="@quiz.Id" class="btn-action-icon" title="Edit Quiz Settings">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button" class="btn-action-icon delete" title="Delete Quiz"
                                                data-bs-toggle="modal" data-bs-target="#deleteQuizModal"
                                                data-quiz-id="@quiz.Id" data-quiz-title="@quiz.Title">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<!-- Delete Quiz Confirmation Modal -->
<div class="modal fade" id="deleteQuizModal" tabindex="-1" aria-labelledby="deleteQuizModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger" id="deleteQuizModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i> Delete Quiz
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-2">Are you sure you want to delete this quiz?</p>
                <div class="p-3 bg-light rounded-3 border">
                    <strong class="text-dark fs-6" id="deleteQuizModalTitle">Quiz Title</strong>
                </div>
                <p class="text-muted small mt-3 mb-0">
                    This action will permanently delete the quiz and its associated questions from memory.
                </p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <form id="deleteQuizForm" asp-controller="Admin" asp-action="DeleteQuiz" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteQuizIdInput" value="" />
                    <button type="button" class="btn btn-qm-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-semibold">
                        <i class="bi bi-trash"></i> Delete Quiz
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
