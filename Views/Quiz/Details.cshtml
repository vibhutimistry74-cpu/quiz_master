@model QuizMaster.Models.Quiz
@{
    ViewData["Title"] = Model.Title + " - Quiz Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Breadcrumbs -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Quiz" asp-action="Index">Quizzes</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                </ol>
            </nav>

            <div class="qm-card p-4 p-md-5 mb-4">
                <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@Model.ImageUrl" alt="@Model.Title" width="70" height="70" style="border-radius: 16px;" />
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge-category">@Model.Category</span>
                                <span class="badge-difficulty-@Model.Difficulty.ToLowerInvariant()">@Model.Difficulty</span>
                            </div>
                            <h2 class="fw-bold mb-0">@Model.Title</h2>
                        </div>
                    </div>
                </div>

                <p class="lead text-sub mb-4">@Model.Description</p>

                <!-- Key Parameters Grid -->
                <div class="row g-3 p-3 bg-light rounded-3 mb-4 border">
                    <div class="col-md-3 col-6 text-center py-2 border-end border-end-md">
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Total Questions</div>
                        <h4 class="fw-bold text-primary mb-0"><i class="bi bi-question-circle"></i> @Model.TotalQuestions</h4>
                    </div>
                    <div class="col-md-3 col-6 text-center py-2 border-end-md">
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Time Limit</div>
                        <h4 class="fw-bold text-primary mb-0"><i class="bi bi-stopwatch"></i> @Model.DurationMinutes min</h4>
                    </div>
                    <div class="col-md-3 col-6 text-center py-2 border-end border-end-md">
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Passing Mark</div>
                        <h4 class="fw-bold text-success mb-0"><i class="bi bi-award"></i> @Model.PassingPercentage%</h4>
                    </div>
                    <div class="col-md-3 col-6 text-center py-2">
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Evaluation</div>
                        <h4 class="fw-bold text-info mb-0"><i class="bi bi-lightning-charge"></i> Instant</h4>
                    </div>
                </div>

                <h5 class="fw-bold mb-3">Examination Structure</h5>
                <ul class="text-sub mb-4 small d-flex flex-column gap-2">
                    <li><i class="bi bi-check2 text-primary me-2"></i> All questions are single-choice multiple choice items (A, B, C, or D).</li>
                    <li><i class="bi bi-check2 text-primary me-2"></i> Each correct answer earns 1 mark towards your final score.</li>
                    <li><i class="bi bi-check2 text-primary me-2"></i> No negative marking is applied for incorrect or omitted responses.</li>
                    <li><i class="bi bi-check2 text-primary me-2"></i> You can jump freely between question numbers at any time.</li>
                </ul>

                <div class="d-flex gap-3 flex-wrap pt-3 border-top">
                    <a asp-controller="Quiz" asp-action="Instructions" asp-route-id="@Model.Id" class="btn btn-qm-primary btn-lg">
                        <i class="bi bi-file-earmark-text"></i> Read Instructions & Start
                    </a>
                    <a asp-controller="Quiz" asp-action="Index" class="btn btn-qm-secondary btn-lg">
                        <i class="bi bi-arrow-left"></i> Back to Quizzes
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
