@model QuizMaster.Models.QuizResultViewModel
@{
    ViewData["Title"] = "Answer Review - " + Model.Attempt.QuizTitle;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Header bar -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <span class="badge-category mb-2">Detailed Breakdown</span>
                    <h2 class="display-6 fw-bold mb-1">Answer Review</h2>
                    <p class="text-muted mb-0">Examination: <strong class="text-dark">@Model.Attempt.QuizTitle</strong> | Score: <strong class="@(Model.Attempt.Status == "Passed" ? "text-success" : "text-danger")">@Model.Attempt.Percentage% (@Model.Attempt.Score/@Model.Attempt.TotalMarks)</strong></p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Quiz" asp-action="Result" asp-route-attemptId="@Model.Attempt.Id" class="btn btn-qm-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Result
                    </a>
                    <a asp-controller="Student" asp-action="Dashboard" class="btn btn-qm-primary">
                        <i class="bi bi-grid-fill"></i> Dashboard
                    </a>
                </div>
            </div>

            <!-- Question Review Cards -->
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                var answer = Model.Attempt.UserAnswers.FirstOrDefault(a => a.QuestionId == q.Id);
                bool isAnswered = answer != null && !string.IsNullOrWhiteSpace(answer.SelectedAnswer);
                bool isCorrect = answer != null && answer.IsCorrect;

                string cardClass = !isAnswered ? "unanswered" : (isCorrect ? "correct" : "wrong");

                string GetOptionText(string? opt) => opt?.ToUpper() switch
                {
                    "A" => q.OptionA,
                    "B" => q.OptionB,
                    "C" => q.OptionC,
                    "D" => q.OptionD,
                    _ => "(No Answer Selected)"
                };

                <div class="review-card @cardClass">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-light text-muted border px-2 py-1 fw-bold">
                            Question @(i + 1) of @Model.Questions.Count
                        </span>

                        @if (!isAnswered)
                        {
                            <span class="badge bg-warning bg-opacity-10 text-warning-emphasis px-3 py-1 rounded-pill fw-bold">
                                <i class="bi bi-dash-circle-fill"></i> Unanswered (0 Marks)
                            </span>
                        }
                        else if (isCorrect)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill fw-bold">
                                <i class="bi bi-check-circle-fill"></i> Correct (+@q.Marks Mark@(q.Marks > 1 ? "s" : ""))
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-1 rounded-pill fw-bold">
                                <i class="bi bi-x-circle-fill"></i> Incorrect (0 Marks)
                            </span>
                        }
                    </div>

                    <h5 class="fw-bold mb-3 text-dark">@q.QuestionText</h5>

                    <!-- Answer Comparison Box -->
                    <div class="answer-comparison-box">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="p-2 rounded-2 @(!isAnswered ? "bg-warning bg-opacity-10 text-warning-emphasis" : (isCorrect ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger"))">
                                    <span class="small d-block text-muted">Your Answer:</span>
                                    <strong class="fs-6">
                                        @if (isAnswered)
                                        {
                                            <span>Option @answer!.SelectedAnswer: @GetOptionText(answer.SelectedAnswer)</span>
                                        }
                                        else
                                        {
                                            <em>Not Attempted</em>
                                        }
                                    </strong>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="p-2 rounded-2 bg-success bg-opacity-10 text-success">
                                    <span class="small d-block text-muted">Correct Answer:</span>
                                    <strong class="fs-6">
                                        <i class="bi bi-check2-circle"></i> Option @q.CorrectAnswer: @GetOptionText(q.CorrectAnswer)
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Explanation -->
                    <div class="explanation-box">
                        <div class="d-flex align-items-center gap-2 mb-1 fw-bold">
                            <i class="bi bi-lightbulb-fill text-success"></i> Academic Explanation:
                        </div>
                        <p class="mb-0 small">@q.Explanation</p>
                    </div>
                </div>
            }

            <div class="text-center py-4">
                <a asp-controller="Quiz" asp-action="Result" asp-route-attemptId="@Model.Attempt.Id" class="btn btn-qm-secondary btn-lg me-2">
                    <i class="bi bi-arrow-left"></i> Return to Result
                </a>
                <a asp-controller="Student" asp-action="Dashboard" class="btn btn-qm-primary btn-lg">
                    <i class="bi bi-grid-fill"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
